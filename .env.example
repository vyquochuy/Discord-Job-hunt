# ==============================================================================
# AI Job Hunter Agent - Environment Configuration Template
# ==============================================================================

# --- Môi trường chạy ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- Backend FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_API_URL=http://backend:8000
# Secret key dùng để xác thực an toàn giữa Discord Bot và Backend API
INTERNAL_API_SECRET=change_me_to_a_secure_random_string_32_chars

# --- Cơ sở dữ liệu (PostgreSQL với pgvector) ---
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=jobhunter_secure_password
POSTGRES_DB=jobhunter_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# URL kết nối bất đồng bộ (asyncpg) cho FastAPI Backend
DATABASE_URL=postgresql+asyncpg://jobhunter:jobhunter_secure_password@postgres:5432/jobhunter_db
# URL kết nối đồng bộ (psycopg) cho Alembic Migrations
DATABASE_URL_SYNC=postgresql://jobhunter:jobhunter_secure_password@postgres:5432/jobhunter_db

# --- Hàng đợi tác vụ (Redis Queue) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Discord Bot Configuration ---
# Lấy từ Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
DISCORD_GUILD_ID=your_discord_server_id_here
# ID tài khoản Discord của bạn (để chỉ duy nhất bạn mới dùng được bot này)
ALLOWED_USER_ID=your_discord_user_id_here

# --- Cấu hình AI & LLM (OpenAI API) ---
OPENAI_API_KEY=your_openai_api_key_here
# Model AI nhanh, giá rẻ dùng để bóc tách thông tin JD thô
AI_MODEL_EXTRACTION=gpt-4o-mini
# Model AI tiêu chuẩn dùng cho so khớp & suy luận
AI_MODEL_STANDARD=gpt-4o
# Model AI cao cấp dùng để viết nội dung Resume / Cover Letter
AI_MODEL_GENERATION=gpt-4o
