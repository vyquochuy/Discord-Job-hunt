/**
 * Job Hunter Platform — Runtime Environment Configuration Template
 * 
 * Instructions:
 * 1. Copy this file to `env.js` in the same directory: `cp env.js.example env.js`
 * 2. Customize `API_URL` with your deployed Cloud Backend URL (e.g. Render, Koyeb, HuggingFace).
 * 3. If left empty, the application automatically defaults to relative `/api/v1` or local dev port fallback.
 */

window.ENV = {
  // Public Cloud Backend API URL (e.g., 'https://job-hunter-api.onrender.com/api/v1')
  API_URL: '',

  // Environment mode ('development' | 'staging' | 'production')
  ENVIRONMENT: 'production',

  // Optional: Web application title override
  APP_TITLE: 'Job Hunter Platform',
};
